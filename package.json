{
  "name": "sidekik-perception",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekik's eyes: screen frames to screen.events, ctx commands, redacted keyframes and clips",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:mock": "tsx --env-file-if-exists=.env scripts/dev-mock.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx --env-file-if-exists=.env bench/run.ts",
    "bench:screens": "tsx bench/gen-screens.ts",
    "test:live": "TEST_PRESIDIO_IMAGE_URL=${TEST_PRESIDIO_IMAGE_URL:-http://localhost:5003} vitest run test/live.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/websocket": "^11.3.3",
    "@sidekik/contracts": "github:sidekik-live/sidekik-platform#v0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
