PORT=8081
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SK_INTERNAL_TOKEN=            # shared; openssl rand -hex 32 (from team vault)
SK_SESSION_SECRET=            # shared with gateway
LOG_LEVEL=info

# Vision (Claude API)
ANTHROPIC_API_KEY=
VISION_PRIMARY=claude-haiku-4-5-20251001
VISION_FALLBACK=              # optional, e.g. claude-sonnet-5-5; unset = retry Haiku once
VISION_TIMEOUT_MS=2000

# Presidio (sidekik-platform dev/docker-compose.yml)
PRESIDIO_ANALYZER_URL=http://localhost:5002     # text redaction of untrusted_screen_text; unset = the text is dropped
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
PRESIDIO_IMAGE_URL=http://localhost:5003        # keyframe redaction; unset = blur PII-labeled fields instead

# Clips
FFMPEG_PATH=                  # optional; default "ffmpeg" on PATH

# Dev only
PERSISTENCE=supabase          # memory = no Supabase writes (dev:mock)
FAKE_VISION=false             # true = offline vision stand-in (dev:mock without a key)
